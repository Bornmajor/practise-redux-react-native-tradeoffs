{
  "build": {
    "dev": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_VARIANT": "dev" }
    },
    "uat": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "APP_VARIANT": "uat" },
      "android": { "buildType": "apk" }
    },
    "prod": {
      "environment": "production",
      "env": { "APP_VARIANT": "prod" }
    }
  }
}
