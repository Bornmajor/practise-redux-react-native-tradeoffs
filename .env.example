# Copy this file to .env and fill in real values.
# EXPO_PUBLIC_* values are bundled into the app as plain text: never put real secrets here.

# Backend base URL. On a phone with Expo Go use your PC's Wi-Fi IP, e.g. http://192.168.1.10:5000
EXPO_PUBLIC_API_URL=
# Must match API_KEY in the backend's .env
EXPO_PUBLIC_API_KEY=
# development | preview | production
EXPO_PUBLIC_APP_ENV=development
